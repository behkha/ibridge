        }
      }
    },
    "%@ is out of reach since %@. Texts arrive when it’s back.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ از %2$@ دور از دسترس است. پیام‌ها وقتی برگردد می‌رسند."
