      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال %@ قطع شود؟"
          }
        }
      }
    },
    "Unlink": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع اتصال"
          }
        }
      }
    },
    "This iPhone stops getting texts and calls until you pair again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این آیفون تا جفت کردن دوباره پیام و تماسی نمی‌گیرد."
          }
        }
      }
    },
    "Pair with Android": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جفت کردن با اندروید"
          }
        }
      }
    },
    "Scan instead": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکن کنید"
          }
        }
      }
    },
    "Type code instead": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد را تایپ کنید"
          }
        }
      }
    },
    "Linking": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال اتصال"
          }
        }
      }
    },
    "No camera": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوربین در دسترس نیست"
          }
        }
      }
    },
    "The code didn’t match. Check it and try again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد درست نبود. دوباره بررسی و امتحان کنید."
          }
        }
      }
    },
    "Too many tries. Reopen the pairing code on Android.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش‌ها زیاد شد. کد جفت کردن را در اندروید دوباره باز کنید."
          }
        }
      }
    },
    "Decline": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رد کردن"
          }
        }
      }
    },
    "Text back": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ با پیام"
          }
        }
      }
    },
    "Calling your Android phone": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با گوشی اندرویدتان تماس می‌گیرد"
          }
        }
      }
    },
    "Your Android phone unlinked this iPhone. Pair again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی اندروید شما اتصال این آیفون را قطع کرد. دوباره جفت کنید."
          }
        }
      }
    },
    "Can’t find your Android phone. Keep its pairing code open and nearby.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی اندروید پیدا نشد. کد جفت کردن را باز و گوشی را نزدیک نگه دارید."
          }
        }
      }
    },
    "Your text wasn’t sent. Check the Android phone’s signal and try again.": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیام ارسال نشد. آنتن گوشی اندروید را بررسی و دوباره امتحان کنید."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باشه"
          }
        }
      }
    }
  },
  "version": "1.0"
}